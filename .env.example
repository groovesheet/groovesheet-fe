# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
NEXT_PUBLIC_API_URL=http://localhost:8080

# Application Configuration
NEXT_PUBLIC_NAME=GrooveSheet
NEXT_PUBLIC_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHAT=false

# Supabase Authentication (browser-visible, inlined at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# HubSpot Forms Integration
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your_portal_id_here
NEXT_PUBLIC_HUBSPOT_FORM_GUID=your_form_guid_here

# Third-party Services
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_public_key
# NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Server-only: origin the Server Components fetch public data from (no
# NEXT_PUBLIC_ prefix, never shipped to the browser). Defaults to production.
# API_ORIGIN=https://api.groovesheet.net

# Optional analytics and payments, all NEXT_PUBLIC_ (inlined at build time):
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_CLARITY_ID=
# NEXT_PUBLIC_ADS_PURCHASE_LABEL=
# NEXT_PUBLIC_AIRWALLEX_ENV=demo
# NEXT_PUBLIC_API_BASE_URL=
