# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
REACT_APP_API_URL=http://localhost:8080

# Application Configuration
REACT_APP_NAME=GrooveSheet
REACT_APP_URL=http://localhost:3000

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_CHAT=false

# Supabase Authentication (required for Create React App)
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# HubSpot Forms Integration
REACT_APP_HUBSPOT_PORTAL_ID=your_portal_id_here
REACT_APP_HUBSPOT_FORM_GUID=your_form_guid_here

# Third-party Services
# REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key
# REACT_APP_GA_ID=your_google_analytics_id
