          },
          "minutesMean": {
            "q": "方案中的「分鐘數」是什麼意思?",
            "a": "分鐘數代表方案內含的總處理音訊時長;曲目越長,按比例消耗的分鐘數越多。"
          },
          "deducted": {
            "q": "分鐘數如何從帳戶扣除?",
            "a": "依據處理音訊長度扣除,不足一分鐘按秒進位,詳見帳單說明。"
          },
          "remaining": {
            "q": "在哪裡查看剩餘分鐘數?",
            "a": "在帳戶儀表板的「帳單與用量」中可查看剩餘分鐘數。"
          },
          "jobFails": {
            "q": "任務失敗怎麼辦?",
            "a": "系統會自動重試;若仍失敗則不會扣除分鐘,並會顯示失敗通知與重試或聯絡支援的選項。"
          },
