{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.groovesheet.net/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.groovesheet.net/seo/sitemap.xml"
    },
    {
      "source": "/explore/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|redditbot).*"
        }
      ],
      "destination": "https://api.groovesheet.net/seo/track/:id"
    },
    {
      "source": "/u/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|redditbot).*"
        }
      ],
      "destination": "https://api.groovesheet.net/seo/creator/:username"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
