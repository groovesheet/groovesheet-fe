# content-app. Copy to .env.local for development; set the same names on the
# CONTENT Vercel project (not the main one) for production, with
# `bash scripts/set-content-env.sh`.
#
# /internal/blog names whichever of these is missing, so start there.

# --- Database -----------------------------------------------------------
# The same Supabase project as the rest of GrooveSheet. Use the POOLER hosts:
# the direct host is IPv6 only and Vercel cannot reach it.
#   DATABASE_URL          transaction pooler, port 6543, for the app
#   DATABASE_URL_SESSION  session pooler,     port 5432, for psql -f schema.sql
DATABASE_URL=
DATABASE_URL_SESSION=

# --- Portal sign-in -----------------------------------------------------
# Either one shared password, or one credential per person. INTERNAL_USERS
# wins if both are set.
#   node scripts/internal-user-hash.mjs '<password>'
# Note the hash uses ':' and not '$': Next runs .env files through
# dotenv-expand, which reads $19e7... as a variable and substitutes nothing,
# silently truncating every hash to "scrypt" and locking everyone out.
INTERNAL_PASSWORD=
# INTERNAL_USERS={"edward-zhang":"scrypt:<salt>:<key>"}
# Optional. Without it the session secret is derived from the password above,
# which means changing the password signs everyone out.
# INTERNAL_SESSION_SECRET=

# --- The scheduled run --------------------------------------------------
# Generated, never typed. Hex, not base64: a '$' in this value is eaten by
# dotenv-expand the same way. Vercel Cron sends it; nobody types it.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Drafting -----------------------------------------------------------
# One of these. OpenRouter adds web search, so drafts can verify facts rather
# than relying only on the fetched article; src/lib/content/llm.ts picks
# whichever is set.
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Optional overrides, comma separated, else generation.portalModels in
# scripts/pipeline.config.json.
# CONTENT_BLOG_MODELS=
# CONTENT_SOCIAL_MODEL=

# --- Social -------------------------------------------------------------
# Both must belong to GrooveSheet's own workspaces. Never reuse a key from
# another company's account.
#   ZERNIO_API_KEY       zernio.com, with LinkedIn and Facebook connected
#   UPLOAD_POST_API_KEY  upload-post.com, with Instagram and Pinterest
#                        connected and at least one Pinterest board created
ZERNIO_API_KEY=
UPLOAD_POST_API_KEY=
